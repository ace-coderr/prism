# PrismCrystal.sol was compiled, deployed and verified with CRLF line endings. Solidity
# metadata hashes the exact source bytes, so pin them for byte-identical rebuilds on any OS.
contracts/contracts/PrismCrystal.sol text eol=crlf

# Real IPFS metadata files: tests hash their exact bytes against on-chain values, so never convert them.
packages/core/test/vectors/metadata-*.json -text
